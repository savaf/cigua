# Config del VPS. Copia a host.env (ignorado por git) y ajusta.
# Aquí NO van secretos: los tokens van en ~/.config/cigua/notify.env del usuario (modo 600)
# o se pasan por entorno al correr un módulo (TS_AUTHKEY).

# Debe coincidir con ssh/.ssh/<hostname>.pub en tus dotfiles (el bootstrap de dotfiles
# enlaza ~/.ssh/github.pub a esa llave).
VPS_HOSTNAME=cigua
VPS_USER=savaf
TIMEZONE=America/Santo_Domingo

# Swap en GB; 0 = no crear. Los agentes + builds de Node se comen la RAM de un VPS pequeño.
SWAP_GB=4

# Llaves públicas que pueden entrar como VPS_USER (una URL por línea).
# Son las llaves por máquina que ya versionas en tus dotfiles.
AUTHORIZED_KEYS_URLS="
https://raw.githubusercontent.com/savaf/dotfiles/main/ssh/.ssh/andrea.pub
https://raw.githubusercontent.com/savaf/dotfiles/main/ssh/.ssh/songbird.pub
"

# Tailscale: tags (deben existir en tagOwners de la política, ver tailscale/policy.hujson).
TAILSCALE_TAGS=tag:server

# Puertos TCP abiertos a internet además de nada. Vacío = solo la tailnet.
# Si este VPS sirve web (Coolify, un proxy), pon "80 443".
# Ojo: los puertos publicados por Docker se saltan ufw (ver docs/recuperacion.md).
PUBLIC_TCP_PORTS=""

# Dotfiles (repo público, se clona por HTTPS sin credenciales).
DOTFILES_REPO=https://github.com/savaf/dotfiles.git
DOTFILES_DIR=dotfiles

# Avisos de agentes (hook Notification de Claude Code). Vacío = sin avisos.
NTFY_URL=https://ntfy.savaf.cloud/agentes
